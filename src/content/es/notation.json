{
  "searchStart": "\\text{Fase: }G'\\leftarrow G,\\ M'\\leftarrow M,\\ R={roots},\\ O\\leftarrow R,\\ I\\leftarrow\\emptyset",
  "searchStartNone": "\\text{Fase: }R=\\emptyset\\text{: ningún vértice está expuesto}",
  "labelRoot": "{v}\\in O,\\ r({v})={v}",
  "labelOuter": "{v}\\in O,\\ p({v})={parent},\\ r({v})={root}",
  "labelInner": "{v}\\in I,\\ p({v})={parent},\\ r({v})={root}",
  "scanEdge": "\\text{se examina }{edge}",
  "oddCycleFound": "{edge}\\text{ une dos exteriores del mismo árbol: ciclo impar}",
  "contract": "{flower}={cycle},\\ \\beta({flower})={base},\\ G'\\leftarrow G'/{flower},\\ M'\\leftarrow M'/{flower}",
  "expand": "\\text{se despliega }{flower}",
  "augment": "P={path},\\ M\\leftarrow M\\oplus E(P)",
  "searchFailed": "Q=\\emptyset\\text{: no hay camino }M'\\text{-aumentante en }G'",
  "done": "\\lvert M\\rvert={size}=\\nu(G)",
  "light": "M\\leftarrow M\\cup\\{{edge}\\}",
  "putOut": "M\\leftarrow M\\setminus\\{{edge}\\}",
  "inspect": "\\Gamma(\\{{v}\\})={set}",
  "chainFound": "P={path}\\text{ es }M\\text{-aumentante}",
  "searchCleared": "O\\leftarrow\\emptyset,\\ I\\leftarrow\\emptyset",
  "scarecrowPlaced": "C\\leftarrow C\\cup\\{{v}\\}",
  "scarecrowRemoved": "C\\leftarrow C\\setminus\\{{v}\\}",
  "stoneLifted": "U\\leftarrow U\\cup\\{{v}\\}",
  "stoneDropped": "U\\leftarrow U\\setminus\\{{v}\\}",
  "declareDone": "\\text{se afirma }\\lvert M\\rvert=\\nu(G)",
  "certificate.stones": "U=I={set}",
  "certificate.count": "\\lvert V\\rvert={n},\\ \\lvert U\\rvert={stones},\\ \\operatorname{odd}(G-U)={odd}",
  "certificate.bound": "\\tfrac12\\bigl(\\lvert V\\rvert+\\lvert U\\rvert-\\operatorname{odd}(G-U)\\bigr)=\\tfrac12({n}+{stones}-{odd})={bound}",
  "certificate.tight": "\\lvert M\\rvert={size}={bound}\\ \\Rightarrow\\ \\nu(G)={size}"
}
