{
  "name": "daa-blossom-game",
  "version": "0.0.0",
  "private": true,
  "description": "A cozy pixel-art puzzle game that teaches Edmonds' Blossom algorithm.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
